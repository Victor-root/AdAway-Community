#
# libpcap 1.10.7, from https://www.tcpdump.org/release/libpcap-1.10.7.tar.xz
# config.h, grammar.c/h and scanner.c/h were generated by the release's configure and Makefile
# with the NDK clang (--host=aarch64-linux-android --disable-shared --disable-usb --disable-netmap
# --disable-bluetooth --disable-dbus --disable-rdma --without-libnl --disable-remote), then the
# ABI dependent sizes made generic: x86, x86_64 and arm configure the same otherwise.
#

LOCAL_PATH := $(call my-dir)
include $(CLEAR_VARS)

# Same sources as the release Makefile: PLATFORM_C_SRC MODULE_C_SRC COMMON_C_SRC GENERATED_C_SRC
LOCAL_SRC_FILES := \
	pcap-linux.c fad-getad.c \
	pcap-netfilter-linux.c \
	pcap.c gencode.c optimize.c nametoaddr.c etherent.c fmtutils.c pcap-util.c savefile.c \
	sf-pcap.c sf-pcapng.c pcap-common.c bpf_image.c bpf_filter.c bpf_dump.c \
	scanner.c grammar.c

LOCAL_CFLAGS := -O2 -fvisibility=hidden -DBUILDING_PCAP -Dpcap_EXPORTS -DHAVE_CONFIG_H

LOCAL_EXPORT_C_INCLUDES := $(LOCAL_PATH)

LOCAL_MODULE := libpcap

include $(BUILD_STATIC_LIBRARY)
