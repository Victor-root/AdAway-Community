    <string name="pref_vpn_diagnostic_log_clear">Diagnoseprotokoll leeren</string>
    <string name="pref_vpn_diagnostic_log_clear_description">Löscht die aufgezeichneten Ereignisse. Tu das, bevor du ein Problem nachstellst, damit das Protokoll nur das Wesentliche enthält.</string>
