    <string name="vpn_persistence_adb_commands">Ef VPN-skjár kerfisins er falinn á sjónvarpinu þínu skaltu nota ADB og endurræsa síðan sjónvarpið:\n\n• Virkja alltaf virkt VPN fyrir AdAway:\n  adb shell settings put secure always_on_vpn_app %1$s\n\n• Óvirkja alltaf virkt VPN:\n  adb shell settings delete secure always_on_vpn_app</string>
