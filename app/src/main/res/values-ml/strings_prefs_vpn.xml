    <!-- Troubleshooting -->
    <string name="pref_vpn_reset">VPN പുനഃസജ്ജീകരിക്കുക</string>
    <string name="pref_vpn_reset_description">VPN കണക്ഷൻ ആദ്യം മുതൽ പുനർനിർമ്മിക്കുക. VPN പ്രവർത്തിക്കുന്നത് നിലയ്ക്കുകയാണെങ്കിൽ (ഇന്റർനെറ്റ് ആക്‌സസ് ഇല്ല അല്ലെങ്കിൽ DNS പിശകുകൾ) ഇത് ഉപയോഗിക്കുക.</string>
    <string name="pref_vpn_reset_done">VPN കണക്ഷൻ പുനർനിർമ്മിച്ചു.</string>
    <string name="pref_vpn_reset_not_running">VPN പ്രവർത്തിക്കുന്നില്ല.</string>
    <string name="pref_vpn_diagnostic_log">ഡയഗ്നോസ്റ്റിക് ലോഗ്</string>
    <string name="pref_vpn_diagnostic_log_description">സമീപകാല പിശകുകളും VPN ഇവന്റുകളും കാണുക, പകർത്തുക അല്ലെങ്കിൽ പങ്കിടുക. ഒരു പ്രശ്നം റിപ്പോർട്ട് ചെയ്യുമ്പോൾ ഉപയോഗപ്രദമാണ്.</string>
    <string name="pref_vpn_diagnostic_log_empty">ഇതുവരെ ഒരു ഇവന്റും രേഖപ്പെടുത്തിയിട്ടില്ല.</string>
    <string name="pref_vpn_diagnostic_log_share">ഡയഗ്നോസ്റ്റിക് ലോഗ് പങ്കിടുക</string>
    <string name="pref_vpn_diagnostic_log_copy">പകർത്തുക</string>
    <string name="pref_vpn_diagnostic_log_copied">ഡയഗ്നോസ്റ്റിക് ലോഗ് ക്ലിപ്പ്ബോർഡിലേക്ക് പകർത്തി.</string>
    <string name="pref_vpn_diagnostic_log_clear">ഡയഗ്നോസ്റ്റിക് ലോഗ് മായ്ക്കുക</string>
    <string name="pref_vpn_diagnostic_log_clear_description">രേഖപ്പെടുത്തിയ ഇവന്റുകൾ ഇല്ലാതാക്കുക. വൃത്തിയുള്ള ഒരു ട്രെയ്‌സ് ലഭിക്കാൻ ഒരു പ്രശ്നം വീണ്ടും സൃഷ്ടിക്കുന്നതിന് മുമ്പ് ഇത് ചെയ്യുക.</string>
    <string name="pref_vpn_diagnostic_log_cleared">ഡയഗ്നോസ്റ്റിക് ലോഗ് മായ്ച്ചു.</string>
