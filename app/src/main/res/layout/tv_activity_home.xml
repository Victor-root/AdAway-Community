<?xml version="1.0" encoding="utf-8"?>
<!--
    Wrapped in a NestedScrollView so the home content stays accessible even when
    the cumulative height exceeds the viewport (small TVs, font scaling, long
    translations, always-on indicator visible, future additions). Below the
    header the screen is split into two side-by-side columns (status/toggle on
    the left, stats/sources/tiles on the right) via tv_mid_guideline: a single
    stacked column of this much content does not fit a 1080p TV viewport, while
    a TV screen has plenty of unused width to spend on a second column. Each
    column is wrapped in its own LinearLayout (tv_left_column / tv_right_column)
    so the whole block can be vertically centered as a unit (vertical_bias=0.5
    between the header and the screen bottom) instead of pinned to the top,
    and both columns keep a uniform 24dp clearance from the screen edges and
    from tv_mid_guideline. fillViewport lets the ConstraintLayout use the full
    viewport height so that centering has real room to work with, and the
    NestedScrollView remains the safety net for very small or very zoomed
    (large font scale) TVs where even two columns don't fit.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="8dp">

        <!-- Top brand band: logo + app name/description + current version -->
        <LinearLayout
            android:id="@+id/tv_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/colorPrimary"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/logo"
                android:contentDescription="@string/app_name"
                app:tint="?attr/colorOnPrimary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_app_name"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:textColor="?attr/colorOnPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_description"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:textColor="?attr/colorOnPrimary"
                    android:alpha="0.85" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textColor="?attr/colorOnPrimary"
                android:alpha="0.85"
                tools:text="v6.5.1-c" />
        </LinearLayout>

        <!-- Pending-state progress: thin indeterminate bar attached to the bottom of
             the header band. Always visible no matter how big or small the screen
             is (the previous bottom-of-content position got clipped on some 4K
             devices with high density). Collapses to 0dp height when GONE so it
             does not affect the layout in idle state. -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="?attr/colorPrimary"
            app:trackThickness="3dp"
            app:trackColor="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@id/tv_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible" />

        <!-- Splits everything below the header into a left (status/toggle) and
             right (stats/sources/tiles) column so the screen fills sideways
             instead of stacking into a tall single column. -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/tv_mid_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.46" />

        <!-- ===================== LEFT COLUMN ===================== -->
        <!-- Status badge/text/toggle/update banner/persistence/theme, wrapped so
             the whole stack can be vertically centered as one block and each
             child centers horizontally against the stack's own (widest-child)
             width, matching the right column's centering. -->
        <LinearLayout
            android:id="@+id/tv_left_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/progress_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_mid_guideline"
            app:layout_constraintVertical_bias="0.5">

            <!-- Centered hero stack: badge (on the same wavy bump-bar background as
                 the mobile FAB) -> status -> state detail -> (optional indicator).
                 Colors/icons mirror HomeActivity.notifyAdBlocked() on mobile: pastel
                 red + the same pause icon when blocking is active, neutral grey +
                 the app logo (mobile shows the logo on its FAB too) when it's off.
                 Set dynamically in TvHomeActivity.updateStatus(); the values below
                 are just the initial/off default before the first observation
                 lands. BumpBottomBar is reused as-is (TV-only usage, not modified):
                 it only cares about its own measured width and centers whatever
                 child it hosts on the crest, so it works just as well at this
                 column's width as it does spanning the phone screen. Its height
                 math reserves exactly enough headroom above the crest for a 56dp
                 FAB-sized child (fabRadiusPx = 28dp radius), and it renders on a
                 software layer for the shadow, which composites strictly within
                 those measured bounds; clipChildren has no effect there, so the
                 badge below is sized to that same 56dp rather than fought with
                 clipping flags. -->
            <org.adaway.ui.home.BumpBottomBar
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/tv_status_badge_container"
                    android:layout_width="56dp"
                    android:layout_height="56dp">

                    <View
                        android:id="@+id/tv_status_badge"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/pastelGreyBg" />

                    <ImageView
                        android:id="@+id/tv_status_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/logo"
                        app:tint="@color/pastelGreyFg"
                        android:contentDescription="@string/tv_log_entry_status_description" />
                </FrameLayout>
            </org.adaway.ui.home.BumpBottomBar>

            <TextView
                android:id="@+id/tv_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                tools:text="Ad-blocking: disabled" />

            <TextView
                android:id="@+id/tv_state_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.7"
                tools:text="Status: idle" />

            <!-- Passive Always-on VPN indicator: shown only when Android has AdAway
                 set as the system-level Always-on VPN. Acts as a "yes, ADB worked"
                 confirmation. -->
            <TextView
                android:id="@+id/tv_always_on_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tv_persistence_indicator_active"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="@color/cardEnabledBackground"
                android:drawablePadding="4dp"
                app:drawableStartCompat="@drawable/baseline_check_24"
                app:drawableTint="@color/cardEnabledBackground"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Primary toggle -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_toggle"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="4dp"
                android:text="@string/button_enable_hosts"
                android:textSize="14sp"
                android:focusable="true"
                android:focusedByDefault="true"
                android:nextFocusRight="@id/tv_blocked_card"
                android:nextFocusDown="@id/btn_persistence"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_tv_power_24"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="20dp" />

            <!-- App update banner: shown only when a new version is available.
                 GONE by default; visibility and focus chain managed in TvHomeActivity. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_app_update"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="4dp"
                android:textSize="13sp"
                android:focusable="true"
                android:visibility="gone"
                android:nextFocusUp="@id/btn_toggle"
                android:nextFocusDown="@id/btn_persistence"
                app:cornerRadius="24dp"
                app:backgroundTint="?attr/colorSecondary"
                app:icon="@drawable/ic_get_app_24dp"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="20dp"
                tools:text="Install version 6.5.2-c"
                tools:visibility="visible" />

            <!-- TV-only extras with no mobile equivalent: VPN persistence hint and
                 the theme toggle (mobile's theme setting lives inside Preferences;
                 TV surfaces it directly since there is no drawer). Same pastel
                 icon-circle + card language as the stat cards and nav tiles
                 instead of plain text buttons, so this row matches the rest of
                 the screen instead of standing out as leftover UI. -->
            <LinearLayout
                android:id="@+id/tv_actions_row3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <!--
                    Hidden by default and only shown in VPN mode, from
                    TvHomeActivity.updatePersistenceVisibility(): root mode has no VPN to keep
                    alive. Every explicit D-pad link aimed here is re-pointed at the theme card
                    when it is hidden, in applyBottomRowFocus().
                -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_persistence"
                    style="@style/Widget.AdAway.TvHomeCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:focusable="true"
                    android:nextFocusUp="@id/btn_toggle"
                    android:nextFocusRight="@id/btn_theme"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/pastelBlueBg"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            app:srcCompat="@drawable/ic_vpn_key_24dp"
                            app:tint="@color/pastelBlueFg" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/tv_button_vpn_persistence"
                            android:textAppearance="?attr/textAppearanceBody2"
                            android:textStyle="bold" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_theme"
                    style="@style/Widget.AdAway.TvHomeCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:nextFocusUp="@id/btn_toggle"
                    android:nextFocusLeft="@id/btn_persistence">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/pastelAmberBg"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            app:srcCompat="@drawable/ic_brightness_medium_24dp"
                            app:tint="@color/pastelAmberFg" />

                        <TextView
                            android:id="@+id/tv_theme_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:textAppearance="?attr/textAppearanceBody2"
                            android:textStyle="bold"
                            tools:text="Dark mode" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== RIGHT COLUMN ===================== -->
        <!-- Stat cards / sources card / nav tiles, wrapped so the whole block can
             be vertically centered the same way as the left column. Width is 0dp
             (not wrap_content): its children need a real width to fill and weight
             against. -->
        <LinearLayout
            android:id="@+id/tv_right_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/progress_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_mid_guideline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.5">

            <!-- Stat cards: same blocked/allowed/redirected counts as the mobile home
                 screen, same icons/colors/strings, tapping opens the matching tab in
                 ListsActivity exactly like HomeActivity.bindClickListeners() does.
                 Each card is weighted (0dp + weight=1) so the row always fills the
                 column, on any TV screen size. -->
            <LinearLayout
                android:id="@+id/tv_stats_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tv_blocked_card"
                    style="@style/Widget.AdAway.TvHomeCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:nextFocusLeft="@id/btn_toggle"
                    android:nextFocusRight="@id/tv_allowed_card"
                    android:nextFocusDown="@id/tv_sources_card">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/pastelRedBg"
                            android:contentDescription="@string/blocked_hosts_label"
                            android:padding="9dp"
                            app:srcCompat="@drawable/baseline_block_24"
                            app:tint="@color/pastelRedFg" />

                        <TextView
                            android:id="@+id/tv_blocked_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAppearance="?attr/textAppearanceHeadline6"
                            android:textStyle="bold"
                            tools:text="76054" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/blocked_hosts_label"
                            android:textAppearance="?attr/textAppearanceBody2" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/blocked_hosts_description"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:textColor="@color/homeCardSubtitle" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tv_allowed_card"
                    style="@style/Widget.AdAway.TvHomeCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:nextFocusLeft="@id/tv_blocked_card"
                    android:nextFocusRight="@id/tv_redirect_card"
                    android:nextFocusDown="@id/tv_sources_card">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/pastelGreenBg"
                            android:contentDescription="@string/allowed_hosts_label"
                            android:padding="9dp"
                            app:srcCompat="@drawable/baseline_check_24"
                            app:tint="@color/pastelGreenFg" />

                        <TextView
                            android:id="@+id/tv_allowed_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAppearance="?attr/textAppearanceHeadline6"
                            android:textStyle="bold"
                            tools:text="0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/allowed_hosts_label"
                            android:textAppearance="?attr/textAppearanceBody2" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/allowed_hosts_description"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:textColor="@color/homeCardSubtitle" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tv_redirect_card"
                    style="@style/Widget.AdAway.TvHomeCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:nextFocusLeft="@id/tv_allowed_card"
                    android:nextFocusDown="@id/tv_sources_card">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/pastelBlueBg"
                            android:contentDescription="@string/redirect_hosts_label"
                            android:padding="9dp"
                            app:srcCompat="@drawable/baseline_compare_arrows_24"
                            app:tint="@color/pastelBlueFg" />

                        <TextView
                            android:id="@+id/tv_redirect_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAppearance="?attr/textAppearanceHeadline6"
                            android:textStyle="bold"
                            tools:text="0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/redirect_hosts_label"
                            android:textAppearance="?attr/textAppearanceBody2" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/redirect_hosts_description"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:textColor="@color/homeCardSubtitle" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Sources card: mirrors HomeActivity's sourcesCardView (up-to-date /
                 outdated counts, tapping the card opens HostsSourcesActivity) with
                 an embedded sync icon that calls homeViewModel.sync(), same as the
                 old standalone Sync button. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tv_sources_card"
                style="@style/Widget.AdAway.TvHomeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nextFocusUp="@id/tv_blocked_card"
                android:nextFocusRight="@id/tv_sync_sources_icon"
                android:nextFocusDown="@id/tv_tile_dns_monitor">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/tv_source_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/pastelRedBg"
                        android:contentDescription="@string/icon_update_status"
                        android:padding="10dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_collections_bookmark_24dp"
                        app:tint="@color/pastelRedFg" />

                    <TextView
                        android:id="@+id/tv_up_to_date_sources"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textAppearance="?attr/textAppearanceSubtitle1"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@+id/tv_outdated_sources"
                        app:layout_constraintEnd_toStartOf="@+id/tv_sync_sources_icon"
                        app:layout_constraintStart_toEndOf="@+id/tv_source_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"
                        tools:text="3 up-to-date sources" />

                    <TextView
                        android:id="@+id/tv_outdated_sources"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:textColor="@color/homeCardSubtitle"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tv_sync_sources_icon"
                        app:layout_constraintStart_toEndOf="@+id/tv_source_icon"
                        app:layout_constraintTop_toBottomOf="@+id/tv_up_to_date_sources"
                        tools:text="0 outdated source" />

                    <ImageView
                        android:id="@+id/tv_sync_sources_icon"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/pastelBlueBg"
                        android:contentDescription="@string/update_hosts_description"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:nextFocusLeft="@id/tv_sources_card"
                        android:nextFocusDown="@id/tv_tile_dns_monitor"
                        android:padding="9dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_sync_24dp"
                        app:tint="@color/pastelBlueFg" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Navigation tiles: mirrors HomeActivity's log/help/preferences tile
                 row. DNS Monitor opens the TV-adapted TvLogActivity, same as the
                 old standalone button; Help and Preferences are new TV entry
                 points (Help had none before; Preferences replaces the old
                 standalone Settings button, so there is one destination, not two). -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/tv_tiles_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tv_tile_dns_monitor"
                    style="@style/Widget.AdAway.TvHomeCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:nextFocusUp="@id/tv_sources_card"
                    android:nextFocusRight="@id/tv_tile_help"
                    android:nextFocusDown="@id/btn_persistence">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/pastelBlueBg"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            app:srcCompat="@drawable/ic_outline_rule_24"
                            app:tint="@color/pastelBlueFg" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/home_tile_log"
                            android:textAppearance="?attr/textAppearanceBody2"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/home_log_subtitle"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:textColor="@color/homeCardSubtitle" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tv_tile_help"
                    style="@style/Widget.AdAway.TvHomeCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:nextFocusLeft="@id/tv_tile_dns_monitor"
                    android:nextFocusUp="@id/tv_sources_card"
                    android:nextFocusRight="@id/tv_tile_preferences"
                    android:nextFocusDown="@id/btn_persistence">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/pastelAmberBg"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            app:srcCompat="@drawable/ic_help_24dp"
                            app:tint="@color/pastelAmberFg" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/home_tile_help"
                            android:textAppearance="?attr/textAppearanceBody2"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/home_help_subtitle"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:textColor="@color/homeCardSubtitle" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tv_tile_preferences"
                    style="@style/Widget.AdAway.TvHomeCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:nextFocusLeft="@id/tv_tile_help"
                    android:nextFocusUp="@id/tv_sources_card"
                    android:nextFocusDown="@id/btn_persistence">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/pastelGreyBg"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            app:srcCompat="@drawable/ic_settings_24dp"
                            app:tint="@color/pastelGreyFg" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/preferences_drawer_item"
                            android:textAppearance="?attr/textAppearanceBody2"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/home_preferences_subtitle"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:textColor="@color/homeCardSubtitle" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
