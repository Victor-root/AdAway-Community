<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/homeBackground">

    <FrameLayout
        android:id="@+id/headerFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.25"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </FrameLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/logoImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:contentDescription="@string/app_logo"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintHeight_percent="0.12"
        app:layout_constraintStart_toStartOf="@+id/headerFrameLayout"
        app:layout_constraintTop_toTopOf="@+id/headerFrameLayout"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.AdAway.Logo"
        app:srcCompat="@drawable/home_logo" />

    <!--
        Title + slogan auto-size to fill the branding block (which scales with the screen
        via the logo's height percent), so big screens use the header space instead of
        showing small fixed-size text. Heights are 0dp and share the logo's vertical span
        through a weighted chain; autosize then picks the largest fitting text.
    -->
    <TextView
        android:id="@+id/appNameTextView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:gravity="bottom|start"
        android:maxLines="1"
        android:text="@string/about_app_name"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        android:textColor="?attr/colorOnPrimary"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="34sp"
        app:autoSizeMinTextSize="13sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@+id/appDescriptionTextView"
        app:layout_constraintEnd_toStartOf="@+id/versionTextView"
        app:layout_constraintStart_toEndOf="@+id/logoImageView"
        app:layout_constraintTop_toTopOf="@+id/logoImageView"
        app:layout_constraintVertical_chainStyle="spread"
        app:layout_constraintVertical_weight="1" />

    <!-- App version, top-right corner of the header; tapping it opens the update screen. -->
    <TextView
        android:id="@+id/versionTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="2dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textColor="?attr/colorOnPrimary"
        app:layout_constraintEnd_toEndOf="@+id/headerFrameLayout"
        app:layout_constraintTop_toTopOf="@+id/headerFrameLayout"
        tools:text="6.5.5-c" />

    <TextView
        android:id="@+id/appDescriptionTextView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="top|start"
        android:maxLines="3"
        android:text="@string/app_description"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textColor="?attr/colorOnPrimary"
        app:autoSizeMaxTextSize="20sp"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="@+id/logoImageView"
        app:layout_constraintEnd_toEndOf="@+id/headerFrameLayout"
        app:layout_constraintStart_toEndOf="@+id/logoImageView"
        app:layout_constraintTop_toBottomOf="@+id/appNameTextView"
        app:layout_constraintVertical_weight="1.4" />

    <androidx.cardview.widget.CardView
        android:id="@+id/blockedHostCardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="-30dp"
        android:elevation="10dp"
        app:cardCornerRadius="8dp"
        app:contentPaddingBottom="16dp"
        app:contentPaddingLeft="8dp"
        app:contentPaddingRight="8dp"
        app:contentPaddingTop="30dp"
        app:layout_constraintEnd_toStartOf="@+id/badge1Space"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerFrameLayout">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/blockedHostCounterTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textStyle="bold"
                tools:text="2250" />

            <TextView
                android:id="@+id/blockedHostTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/blocked_hosts_label" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/blockedHostImageView"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/pastelRedBg"
        android:contentDescription="@string/blocked_hosts_label"
        android:elevation="12dp"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@+id/blockedHostCardView"
        app:layout_constraintEnd_toEndOf="@+id/blockedHostCardView"
        app:layout_constraintStart_toStartOf="@+id/blockedHostCardView"
        app:layout_constraintTop_toTopOf="@+id/blockedHostCardView"
        app:srcCompat="@drawable/baseline_block_24"
        app:tint="@color/pastelRedFg" />

    <Space
        android:id="@+id/badge1Space"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/headerFrameLayout"
        app:layout_constraintEnd_toStartOf="@id/allowedHostCardView"
        app:layout_constraintHorizontal_weight="0.2"
        app:layout_constraintStart_toEndOf="@id/blockedHostCardView"
        app:layout_constraintTop_toBottomOf="@+id/headerFrameLayout" />

    <androidx.cardview.widget.CardView
        android:id="@+id/allowedHostCardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-30dp"
        android:elevation="10dp"
        app:cardCornerRadius="8dp"
        app:contentPaddingBottom="16dp"
        app:contentPaddingLeft="8dp"
        app:contentPaddingRight="8dp"
        app:contentPaddingTop="30dp"
        app:layout_constraintEnd_toStartOf="@+id/badge2Space"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/badge1Space"
        app:layout_constraintTop_toBottomOf="@+id/headerFrameLayout">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/allowedHostCounterTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textStyle="bold"
                tools:text="25" />

            <TextView
                android:id="@+id/allowedHostTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/allowed_hosts_label" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/allowedHostImageView"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/pastelGreenBg"
        android:contentDescription="@string/allowed_hosts_label"
        android:elevation="12dp"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@+id/allowedHostCardView"
        app:layout_constraintEnd_toEndOf="@+id/allowedHostCardView"
        app:layout_constraintStart_toStartOf="@+id/allowedHostCardView"
        app:layout_constraintTop_toTopOf="@+id/allowedHostCardView"
        app:srcCompat="@drawable/baseline_check_24"
        app:tint="@color/pastelGreenFg" />

    <Space
        android:id="@+id/badge2Space"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/headerFrameLayout"
        app:layout_constraintEnd_toStartOf="@id/redirectHostCardView"
        app:layout_constraintHorizontal_weight="0.2"
        app:layout_constraintStart_toEndOf="@id/allowedHostCardView"
        app:layout_constraintTop_toBottomOf="@+id/headerFrameLayout" />

    <androidx.cardview.widget.CardView
        android:id="@+id/redirectHostCardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-30dp"
        android:layout_marginEnd="16dp"
        android:elevation="10dp"
        app:cardCornerRadius="8dp"
        app:contentPaddingBottom="16dp"
        app:contentPaddingLeft="8dp"
        app:contentPaddingRight="8dp"
        app:contentPaddingTop="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/badge2Space"
        app:layout_constraintTop_toBottomOf="@+id/headerFrameLayout">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/redirectHostCounterTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textStyle="bold"
                tools:text="2" />

            <TextView
                android:id="@+id/redirectHostTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/redirect_hosts_label" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/redirectHostImageView"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/pastelBlueBg"
        android:contentDescription="@string/redirect_hosts_label"
        android:elevation="12dp"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@+id/redirectHostCardView"
        app:layout_constraintEnd_toEndOf="@+id/redirectHostCardView"
        app:layout_constraintStart_toStartOf="@+id/redirectHostCardView"
        app:layout_constraintTop_toTopOf="@+id/redirectHostCardView"
        app:srcCompat="@drawable/baseline_compare_arrows_24"
        app:tint="@color/pastelBlueFg" />

    <!--
        ===========================================================================
        Lower zone (refactored): everything below the 3 statistic cards lives in a
        scroll container that now spans all the way to the bottom of the screen,
        BEHIND the floating bottom bar / FAB. clipToPadding=false plus a bottom
        padding equal to the bar height let the tiles slide smoothly behind the
        white wave while still being able to scroll fully clear of the bar. The red
        header and the 3 statistic cards above are left untouched.
        ===========================================================================
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/home_bottom_bar_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blockedHostCardView">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- In-app update banner (kept as-is, just relocated into the scroll container) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/updateAvailableCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardCornerRadius="20dp"
                app:contentPadding="16dp"
                tools:visibility="gone">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/updateBannerIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/update_banner_title"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_get_app_24dp"
                        app:tint="?attr/colorOnPrimary" />

                    <TextView
                        android:id="@+id/updateBannerTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/update_banner_title"
                        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                        android:textColor="?attr/colorOnPrimary"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@+id/updateBannerSubtitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/updateBannerIcon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/updateBannerSubtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:textColor="?attr/colorOnPrimary"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/updateBannerIcon"
                        app:layout_constraintTop_toBottomOf="@+id/updateBannerTitle"
                        tools:text="Tap to install 6.5.2-c" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- ====================== Sources card (modernised) ====================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/sourcesCardView"
                style="@style/Widget.AdAway.HomeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/sourceImageView"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/pastelRedBg"
                        android:contentDescription="@string/icon_update_status"
                        android:padding="12dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_collections_bookmark_24dp"
                        app:tint="@color/pastelRedFg" />

                    <TextView
                        android:id="@+id/upToDateSourcesTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@+id/outdatedSourcesTextView"
                        app:layout_constraintEnd_toStartOf="@+id/syncSourcesImageView"
                        app:layout_constraintStart_toEndOf="@+id/sourceImageView"
                        app:layout_constraintTop_toTopOf="@+id/sourceImageView"
                        app:layout_constraintVertical_chainStyle="packed"
                        tools:text="3 up-to-date sources" />

                    <TextView
                        android:id="@+id/outdatedSourcesTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                        android:textColor="@color/homeCardSubtitle"
                        app:layout_constraintBottom_toTopOf="@+id/failedSourcesTextView"
                        app:layout_constraintEnd_toStartOf="@+id/syncSourcesImageView"
                        app:layout_constraintStart_toEndOf="@+id/sourceImageView"
                        app:layout_constraintTop_toBottomOf="@+id/upToDateSourcesTextView"
                        tools:text="0 outdated source" />

                    <TextView
                        android:id="@+id/failedSourcesTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                        android:textColor="@color/blocked"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@+id/sourceImageView"
                        app:layout_constraintEnd_toStartOf="@+id/syncSourcesImageView"
                        app:layout_constraintStart_toEndOf="@+id/sourceImageView"
                        app:layout_constraintTop_toBottomOf="@+id/outdatedSourcesTextView"
                        tools:text="1 unreachable source"
                        tools:visibility="visible" />

                    <!--
                        Single action: checking and downloading were two separate buttons before,
                        but retrieveHostsSources() (triggered by sync()) already checks each
                        source's online date and only re-downloads what actually changed, so one
                        tap covers both without wasting a request.
                    -->
                    <ImageView
                        android:id="@+id/syncSourcesImageView"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/pastelBlueBg"
                        android:contentDescription="@string/update_hosts_description"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="10dp"
                        app:layout_constraintBottom_toBottomOf="@+id/sourceImageView"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/sourceImageView"
                        app:srcCompat="@drawable/ic_sync_24dp"
                        app:tint="@color/pastelBlueFg" />

                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/sourcesContentBarrier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:barrierDirection="bottom"
                        app:constraint_referenced_ids="sourceImageView,outdatedSourcesTextView,failedSourcesTextView,syncSourcesImageView" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/sourcesProgressBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/sourcesContentBarrier"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/stateTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                        android:textColor="@color/homeCardSubtitle"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/sourcesProgressBar"
                        tools:text="@string/status_check_source"
                        tools:visibility="visible" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Navigation tiles: 3 compact cards on a single row so everything fits ===== -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <!-- DNS request log -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/logCardView"
                    style="@style/Widget.AdAway.HomeCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal|top"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/logImageView"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/pastelBlueBg"
                            android:contentDescription="@null"
                            android:padding="12dp"
                            app:srcCompat="@drawable/ic_outline_rule_24"
                            app:tint="@color/pastelBlueFg" />

                        <TextView
                            android:id="@+id/logTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/home_tile_log"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="14sp"
                            app:autoSizeMinTextSize="9sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="@string/home_log_subtitle"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                            android:textColor="@color/homeCardSubtitle" />

                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>

                <!-- Help and tips -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/helpCardView"
                    style="@style/Widget.AdAway.HomeCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal|top"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/helpIconImageView"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/pastelAmberBg"
                            android:contentDescription="@null"
                            android:padding="12dp"
                            app:srcCompat="@drawable/ic_help_24dp"
                            app:tint="@color/pastelAmberFg" />

                        <TextView
                            android:id="@+id/helpTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/home_tile_help"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="14sp"
                            app:autoSizeMinTextSize="9sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="@string/home_help_subtitle"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                            android:textColor="@color/homeCardSubtitle" />

                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>

                <!-- Preferences -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/preferencesCardView"
                    style="@style/Widget.AdAway.HomeCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal|top"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/preferencesImageView"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/pastelGreyBg"
                            android:contentDescription="@null"
                            android:padding="12dp"
                            app:srcCompat="@drawable/ic_settings_24dp"
                            app:tint="@color/pastelGreyFg" />

                        <TextView
                            android:id="@+id/preferencesTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/preferences_drawer_item"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="14sp"
                            app:autoSizeMinTextSize="9sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="@string/home_preferences_subtitle"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                            android:textColor="@color/homeCardSubtitle" />

                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!--
                ====================== VPN persistence ======================
                Full width below the tile row rather than a fourth tile in it: the three tiles
                already share one row and a fourth would squeeze every label. Opens the same
                dialog the TV home screen has had, which is where the Always-on VPN shortcut
                lives - the one recovery path that survives a force-stop, and until now
                unreachable anywhere on mobile.

                Hidden by default and only shown in VPN mode, from
                HomeActivity.updatePersistenceCardVisibility(): root mode has no VPN to keep
                alive at all. Defaulting to gone rather than visible so a root install never
                renders it, not even for the frame before onResume runs.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/persistenceCardView"
                style="@style/Widget.AdAway.HomeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                tools:visibility="visible">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/persistenceImageView"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/pastelGreenBg"
                        android:contentDescription="@null"
                        android:padding="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_vpn_key_24dp"
                        app:tint="@color/pastelGreenFg" />

                    <TextView
                        android:id="@+id/persistenceTitleTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/vpn_persistence_title"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@+id/persistenceSubtitleTextView"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/persistenceImageView"
                        app:layout_constraintTop_toTopOf="@+id/persistenceImageView"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/persistenceSubtitleTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/home_persistence_subtitle"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                        android:textColor="@color/homeCardSubtitle"
                        app:layout_constraintBottom_toBottomOf="@+id/persistenceImageView"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/persistenceImageView"
                        app:layout_constraintTop_toBottomOf="@+id/persistenceTitleTextView" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
