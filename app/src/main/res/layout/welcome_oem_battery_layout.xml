<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:padding="20dp">

        <ImageView
            android:id="@+id/headerImageView"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/welcome_oem_battery_header"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_settings_24dp"
            app:tint="?attr/colorOnPrimary" />

        <TextView
            android:id="@+id/headerTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/welcome_oem_battery_header"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AdAway.Welcome.Header"
            android:textColor="?attr/colorOnPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerImageView" />

        <TextView
            android:id="@+id/summaryTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/welcome_oem_battery_summary"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AdAway.Welcome.Body"
            android:textColor="?attr/colorOnPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerTextView" />

        <!-- Sets expectations before the tip below: names/menus are pointers, not a guaranteed
             exact walkthrough, since they genuinely vary by firmware/region/version. -->
        <TextView
            android:id="@+id/oemDisclaimerTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.8"
            android:text="@string/welcome_oem_battery_disclaimer"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AdAway.Welcome.Small"
            android:textColor="?attr/colorOnPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/summaryTextView" />

        <!-- Single tip for the detected brand only (or the generic fallback, if none matched),
             filled in code. No brand picker: just what applies to this phone. -->
        <androidx.cardview.widget.CardView
            android:id="@+id/oemTipCardView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/cardBackground"
            app:cardCornerRadius="16dp"
            app:contentPadding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/oemDisclaimerTextView">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/oemTipLabelTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:textAppearance="@style/TextAppearance.AdAway.Welcome.Body"
                    android:textColor="@color/onPrimary"
                    android:textStyle="bold"
                    tools:text="Oppo / OnePlus / Realme (ColorOS)" />

                <TextView
                    android:id="@+id/oemTipPathTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:alpha="0.85"
                    android:textAppearance="@style/TextAppearance.AdAway.Welcome.Small"
                    android:textColor="@color/onPrimary"
                    tools:text="App info › Battery usage" />

                <TextView
                    android:id="@+id/oemTipInstructionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:justificationMode="inter_word"
                    android:textAppearance="@style/TextAppearance.AdAway.Welcome.Body"
                    android:textColor="@color/onPrimary"
                    tools:text="Choose “Allow background activity” (sometimes shown as “No restrictions”)." />

                <TextView
                    android:id="@+id/oemTipSecondaryTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:justificationMode="inter_word"
                    android:textAppearance="@style/TextAppearance.AdAway.Welcome.Body"
                    android:textColor="@color/onPrimary"
                    android:visibility="gone"
                    tools:text="Also look for an “Auto-launch” toggle for AdAway."
                    tools:visibility="visible" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openAppInfoButton"
            style="@style/Widget.AdAway.Button.OnRed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp"
            android:text="@string/welcome_oem_battery_action"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/oemTipCardView" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
