<?xml version="1.0" encoding="utf-8"?>
<!--
    Header AdAway logo source.

    Built from the launcher icon layers (primary-colored tile + foreground artwork)
    instead of a launcher icon mipmap. Those are adaptive-icons, and when shown in
    an ImageView it is clipped by the OEM icon mask (round on some devices, square on
    others). Drawing the layers ourselves and letting a ShapeableImageView round the
    corners gives an identical rounded result on every device, including Android 10.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
        </shape>
    </item>
    <item android:drawable="@mipmap/icon_foreground" />
</layer-list>
