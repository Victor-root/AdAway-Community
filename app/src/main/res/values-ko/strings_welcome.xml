<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="welcome_first_step">마법사 1단계</string>
    <string name="welcome_second_step">마법사 2단계</string>
    <string name="welcome_third_step">마법사 3단계</string>
    <string name="welcome_fourth_step">마법사 4단계</string>
    <string name="welcome_method_header">AdAway에 오신 것을 환영합니다!</string>
    <string name="welcome_method_summary">AdAway는 두 가지 광고 차단 방식을 제공합니다. 원하는 방식을 선택하세요:</string>
    <string name="welcome_root_method_title">루트 기반\n광고 차단</string>
    <string name="welcome_root_method_text1">더 빠름</string>
    <string name="welcome_root_method_text2">배터리 절약</string>
    <string name="welcome_root_method_text3">루트 필요</string>
    <string name="welcome_vpn_method_title">VPN 기반\n광고 차단</string>
    <string name="welcome_vpn_method_text1">더 느림</string>
    <string name="welcome_vpn_method_text2">백그라운드에서 실행</string>
    <string name="welcome_vpn_method_text3">호환성</string>
    <string name="welcome_root_missing_title">루팅된 Android가 필요합니다</string>
    <string name="welcome_root_missile_description">su 바이너리를 찾을 수 없거나 AdAway에 루트 권한을 허용하지 않았습니다.\n\n기기가 루팅되지 않은 경우 이런 일이 발생할 수 있습니다. 기기를 루팅하는 방법은 wiki.lineageos.org 또는 다른 Android 관련 웹사이트에서 확인할 수 있습니다.</string>
    <string name="welcome_vpn_alwayson_title">상시 VPN이 켜져 있습니다</string>
    <string name="welcome_vpn_alwayson_description">다른 VPN에 “상시 VPN” 설정이 켜져 있는 것을 AdAway가 감지했습니다.\n\n이 경우 AdAway가 VPN 접근을 요청할 수 없습니다. 해당 VPN의 “상시 VPN” 설정을 끄고 다시 시도해 주세요.</string>
    <string name="welcome_vpn_alwayson_blocked_description">AdAway가 VPN 접근을 요청하지 못했습니다.\n\n다른 VPN에 “상시 VPN” 설정이 켜져 있기 때문일 수 있습니다. 이 설정이 켜져 있는 VPN이 있는지 확인하고, 있다면 끈 다음 다시 시도해 주세요.</string>
    <string name="welcome_vpn_alwayson_settings_action">“VPN” 설정 열기</string>
    <string name="welcome_method_pro_logo">장점</string>
    <string name="welcome_method_con_logo">단점</string>
    <string name="welcome_sync_header">동기화 중</string>
    <string name="welcome_synced_header">동기화 완료!</string>
    <string name="welcome_sync_summary">AdAway는 차단할 광고 네트워크 목록을 온라인 소스에서 다운로드합니다. 나중에 설정에서 원하는 대로 바꿀 수 있습니다.</string>
    <string name="welcome_sync_retry_logo">동기화 다시 시도</string>
    <string name="welcome_sync_error">동기화 실패: %1$s 지금 다시 시도하시겠습니까?</string>
    <string name="welcome_sync_notifications">알림으로 광고 차단 상태와 제어 기능을 표시하고, 앱 업데이트 소식(연 몇 회)을 알려 드릴 수 있습니다. 최신 상태를 유지하려면 알림을 켜세요.</string>
    <string name="welcome_sync_leave_early_title">동기화가 아직 끝나지 않았습니다</string>
    <string name="welcome_sync_leave_early_message">차단 목록 다운로드가 아직 끝나지 않았습니다. 지금 계속하면 백그라운드에서 이어서 진행되며, 여기서 끝날 때까지 기다릴 수도 있습니다.</string>
    <string name="welcome_sync_leave_early_wait">기다리기</string>
    <string name="welcome_sync_leave_early_continue">그래도 계속</string>
    <string name="welcome_battery_header">백그라운드에서도 보호 유지</string>
    <string name="welcome_battery_summary">Android는 절전을 위해 백그라운드에서 AdAway의 VPN을 일시중지할 수 있으며, 이 경우 광고 차단이 알림 없이 멈출 수 있습니다. AdAway가 배터리 최적화를 무시하도록 허용하면 계속 실행됩니다.</string>
    <string name="welcome_battery_action">허용</string>
    <string name="welcome_battery_granted">허용됨 ✓</string>
    <string name="welcome_battery_footnote_prefix">나중에 언제든지 다음 경로에서 변경할 수 있습니다:</string>
    <string-array name="welcome_battery_footnote_path">
        <item>설정</item>
        <item>앱</item>
        <item>AdAway</item>
        <item>배터리</item>
    </string-array>
    <string name="welcome_oem_battery_header">한 가지 더: 휴대전화 자체 배터리 관리 기능</string>
    <string name="welcome_oem_battery_summary">일부 제조사에는 AdAway를 차단할 수 있는 자체 배터리 관리 기능이 있습니다. 사용 중인 기기에서 확인할 항목은 다음과 같습니다:</string>
    <string name="welcome_oem_battery_action">앱 정보 열기</string>
    <string name="welcome_oem_battery_open_failed">앱 정보 화면을 열 수 없습니다. 설정 → 앱 → AdAway에서 직접 열어 주세요.</string>
    <string name="welcome_oem_battery_disclaimer">정확한 안내가 아니라 일반적인 참고 사항입니다. 항목 이름과 위치는 휴대전화 모델과 Android 버전에 따라 다를 수 있습니다.</string>
    <string name="welcome_oem_battery_label_oneui">Samsung (One UI)</string>
    <string-array name="welcome_oem_battery_path_oneui">
        <item>앱 정보</item>
        <item>배터리</item>
    </string-array>
    <string name="welcome_oem_battery_instruction_oneui">“백그라운드 사용 제한” › “절전 예외 앱” 같은 항목을 찾아 그 목록에 AdAway를 추가하세요.</string>
    <string name="welcome_oem_battery_secondary_oneui">“자동 최적화” 설정이 있는지도 확인하고, “필요할 때 다시 시작”이 있으면 끄세요.</string>
    <string name="welcome_oem_battery_label_miui">Xiaomi / Redmi / POCO (MIUI / HyperOS)</string>
    <string-array name="welcome_oem_battery_path_miui">
        <item>앱 정보</item>
        <item>배터리 세이버</item>
    </string-array>
    <string name="welcome_oem_battery_instruction_miui">“제한 없음”을 선택하세요.</string>
    <string name="welcome_oem_battery_secondary_miui">“자동 시작”(최신 버전에서는 “백그라운드 자동 시작”)도 켜세요.</string>
    <string name="welcome_oem_battery_label_coloros">Oppo / OnePlus / Realme (ColorOS)</string>
    <string-array name="welcome_oem_battery_path_coloros">
        <item>앱 정보</item>
        <item>배터리 사용량</item>
    </string-array>
    <string name="welcome_oem_battery_instruction_coloros">“백그라운드 활동 허용”을 선택하세요(“제한 없음”으로 표시되는 경우도 있습니다).</string>
    <string name="welcome_oem_battery_secondary_coloros">AdAway의 “자동 실행” 스위치도 찾아 켜 두세요(주로 설정 › 앱에 있습니다). 강제 종료된 뒤에도 스스로 다시 시작할 수 있습니다.</string>
    <string name="welcome_oem_battery_label_emui">Huawei / Honor (EMUI / MagicOS)</string>
    <string-array name="welcome_oem_battery_path_emui">
        <item>앱 정보</item>
        <item>배터리</item>
    </string-array>
    <string name="welcome_oem_battery_instruction_emui">“앱 실행 관리”를 찾아 “자동 관리”를 끈 다음, “자동 실행”, “보조 실행”, “백그라운드 활동” 3가지를 모두 켜세요.</string>
    <string name="welcome_oem_battery_secondary_emui">최근 앱 화면에서 AdAway를 잠가 두세요(카드를 아래로 밀어 자물쇠 아이콘이 나타날 때까지 내립니다).</string>
    <string name="welcome_oem_battery_label_funtouch">vivo / iQOO (Funtouch / OriginOS)</string>
    <string-array name="welcome_oem_battery_path_funtouch">
        <item>앱 정보</item>
        <item>배터리 사용량</item>
    </string-array>
    <string name="welcome_oem_battery_instruction_funtouch">백그라운드 전력 사용 옵션을 찾아 “백그라운드 전력 사용 제한 안 함”을 선택하세요(“스마트 제어”는 안 됩니다).</string>
    <string name="welcome_oem_battery_secondary_funtouch">AdAway의 “자동 시작” 설정도 찾아 켜 두세요(주로 설정 › 앱에 있습니다).</string>
    <string name="welcome_oem_battery_label_generic">기타 제조사</string>
    <string name="welcome_oem_battery_tip_generic">앱 정보에서 배터리 또는 백그라운드 활동 설정을 찾아 AdAway가 제한되어 있지 않은지 확인하세요.</string>
    <string name="welcome_back_button">이전</string>
    <string name="welcome_next_button">다음</string>
    <string name="welcome_finish_button">완료</string>
    <string name="tv_welcome_intro_subtitle">이 간단한 마법사가 이 기기에서 광고 차단을 켜 드립니다.</string>
    <string name="tv_welcome_start_button">시작하기</string>
    <string name="tv_welcome_method_header">차단 방식 선택</string>
    <string name="tv_welcome_method_root_button">루트 사용</string>
    <string name="tv_welcome_method_root_body">더 빠르고 배터리를 적게 사용합니다. 루팅된 기기가 필요합니다.</string>
    <string name="tv_welcome_method_vpn_button">VPN 사용</string>
    <string name="tv_welcome_method_vpn_body">루트 없이 작동하며 모든 Android TV 기기와 호환됩니다.</string>
    <string name="tv_welcome_activate_header">광고 차단 켜기</string>
    <string name="tv_welcome_activate_body">로컬 VPN입니다. 트래픽을 외부 서버로 보내지 않고 이 기기에서 직접 광고를 걸러냅니다.</string>
</resources>
