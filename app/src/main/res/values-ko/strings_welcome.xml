    <string name="welcome_root_missing_title">루팅 필수</string>
    <string name="welcome_root_missile_description">su 바이너리를 찾을 수 없거나 AdAway에 대한 루팅 권한을 허용하지 않은 경우.\n\n이 문제는 장치가 루팅되지 않은 경우에 발생할 수 있습니다. wiki.lineageos.org 또는 다른 안드로이드 웹 사이트에서 장치를 루팅하는 방법에 대한 정보를 찾을 수 있습니다.</string>
    <string name="welcome_method_pro_logo">Pro</string>
    <string name="welcome_method_con_logo">Con</string>
