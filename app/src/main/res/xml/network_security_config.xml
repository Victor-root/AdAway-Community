<?xml version="1.0" encoding="utf-8"?>
<!-- The app checks that the certificate of the root web server is installed. -->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="true">localhost</domain>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
