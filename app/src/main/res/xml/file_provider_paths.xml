<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!--
        The APK actually handed to the system installer lives in the app's PRIVATE cache
        (ApkInstaller copies it there once verified), which no other application can reach.
        The external entry stays because DownloadManager cannot write to private storage and
        still needs somewhere to stage the download.
    -->
    <cache-path
        name="internal_cache"
        path="." />
    <external-cache-path
        name="external_cache"
        path="." />
    <!--
        The system hosts file, for "Open hosts file": apps cannot be handed a file:// URI (it
        throws FileUriExposedException) and the hosts file is world readable.
    -->
    <root-path
        name="system_etc"
        path="system/etc/" />
</paths>
