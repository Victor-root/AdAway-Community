<?xml version="1.0" encoding="utf-8"?>
<!--
    Everything lives on this single screen. The VPN and root settings used to sit behind an
    entry that opened a sub-screen of its own, which meant tapping into a menu to reach the
    settings the menu was named after. They are inlined here as two dedicated sections, VPN
    first, so opening Preferences shows the actual settings straight away.

    Only the section matching the active ad-blocking method is enabled; the other is dimmed by
    PrefsMainFragment, the same way the two entries that led here used to be.

    Every setting carries an icon so the list can be scanned at a glance. The description rows
    have none, but still reserve the space so their text lines up with the settings they
    introduce.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/pref_main_title">

    <PreferenceCategory app:title="@string/pref_general_category">
        <ListPreference
            app:defaultValue="@string/pref_dark_theme_mode_def"
            app:entries="@array/pref_dark_theme_modes"
            app:entryValues="@array/pref_dark_theme_mode_entry_values"
            app:icon="@drawable/ic_brightness_medium_24dp"
            app:key="@string/pref_dark_theme_mode_key"
            app:singleLineTitle="false"
            app:title="@string/pref_dark_theme" />
        <Preference
            app:fragment="org.adaway.ui.prefs.PrefsUpdateFragment"
            app:icon="@drawable/ic_sync_24dp"
            app:singleLineTitle="false"
            app:title="@string/pref_update_configuration" />
    </PreferenceCategory>

    <!-- ==================== VPN ad blocker ==================== -->
    <PreferenceCategory
        app:key="@string/pref_vpn_ad_block_method_key"
        app:title="@string/pref_vpn_ad_blocker_configuration">
        <SwitchPreferenceCompat
            app:defaultValue="@bool/pref_vpn_service_on_boot_def"
            app:icon="@drawable/ic_power_settings_new_24dp"
            app:key="@string/pref_vpn_service_on_boot_key"
            app:singleLineTitle="false"
            app:title="@string/pref_vpn_service_on_boot" />
        <SwitchPreferenceCompat
            app:defaultValue="@bool/pref_vpn_watchdog_enabled_def"
            app:icon="@drawable/ic_network_check_24dp"
            app:key="@string/pref_vpn_watchdog_enabled_key"
            app:singleLineTitle="false"
            app:summary="@string/pref_vpn_service_monitor_description"
            app:title="@string/pref_vpn_service_monitor" />

        <!-- App bypass -->
        <Preference
            app:persistent="false"
            app:selectable="false"
            app:singleLineTitle="false"
            app:summary="@string/pref_vpn_excluded_apps_description" />
        <ListPreference
            app:defaultValue="@string/pref_vpn_excluded_system_apps_default"
            app:entries="@array/pref_vpn_excluded_system_apps_entries"
            app:entryValues="@array/pref_vpn_excluded_system_apps_values"
            app:icon="@drawable/ic_android_24dp"
            app:key="@string/pref_vpn_excluded_system_apps_key"
            app:singleLineTitle="false"
            app:title="@string/pref_vpn_exclude_system_apps"
            app:useSimpleSummaryProvider="true" />
        <Preference
            app:defaultValue="@string/pref_vpn_excluded_user_apps_default"
            app:icon="@drawable/ic_apps_24dp"
            app:key="@string/pref_vpn_excluded_user_apps_key"
            app:singleLineTitle="false"
            app:title="@string/pref_vpn_exclude_user_apps" />

        <!-- Troubleshooting -->
        <Preference
            app:icon="@drawable/ic_restart_alt_24dp"
            app:key="@string/pref_vpn_reset_key"
            app:persistent="false"
            app:singleLineTitle="false"
            app:summary="@string/pref_vpn_reset_description"
            app:title="@string/pref_vpn_reset" />
        <SwitchPreferenceCompat
            app:defaultValue="@bool/pref_vpn_diagnostic_log_enabled_def"
            app:icon="@drawable/ic_record_24dp"
            app:key="@string/pref_vpn_diagnostic_log_enabled_key"
            app:singleLineTitle="false"
            app:summary="@string/pref_vpn_diagnostic_log_enabled_description"
            app:title="@string/pref_vpn_diagnostic_log_enabled" />
        <Preference
            app:icon="@drawable/ic_article_24dp"
            app:key="@string/pref_vpn_diagnostic_log_key"
            app:persistent="false"
            app:singleLineTitle="false"
            app:summary="@string/pref_vpn_diagnostic_log_description"
            app:title="@string/pref_vpn_diagnostic_log" />
        <Preference
            app:icon="@drawable/ic_delete_sweep_24dp"
            app:key="@string/pref_vpn_diagnostic_log_clear_key"
            app:persistent="false"
            app:singleLineTitle="false"
            app:summary="@string/pref_vpn_diagnostic_log_clear_description"
            app:title="@string/pref_vpn_diagnostic_log_clear" />
    </PreferenceCategory>

    <!-- ==================== Root ad blocker ==================== -->
    <PreferenceCategory
        app:key="@string/pref_root_ad_block_method_key"
        app:title="@string/pref_root_ad_blocker_configuration">
        <Preference
            app:icon="@drawable/ic_edit_note_24dp"
            app:key="@string/pref_open_hosts_key"
            app:persistent="false"
            app:singleLineTitle="false"
            app:title="@string/pref_root_open_hosts" />

        <!-- Redirection -->
        <Preference
            app:persistent="false"
            app:selectable="false"
            app:singleLineTitle="false"
            app:summary="@string/pref_hosts_redirection_summary" />
        <EditTextPreference
            app:defaultValue="@string/pref_redirection_ipv4_def"
            app:dialogLayout="@layout/pref_edittext_dialog"
            app:icon="@drawable/ic_alt_route_24dp"
            app:key="@string/pref_redirection_ipv4_key"
            app:singleLineTitle="false"
            app:title="@string/pref_redirection_ipv4" />
        <EditTextPreference
            app:defaultValue="@string/pref_redirection_ipv6_def"
            app:dialogLayout="@layout/pref_edittext_dialog"
            app:enabled="false"
            app:icon="@drawable/ic_alt_route_24dp"
            app:key="@string/pref_redirection_ipv6_key"
            app:singleLineTitle="false"
            app:title="@string/pref_redirection_ipv6" />

        <!-- Web server -->
        <Preference
            app:persistent="false"
            app:selectable="false"
            app:singleLineTitle="false"
            app:summary="@string/pref_webserver_summary" />
        <SwitchPreferenceCompat
            app:defaultValue="@bool/pref_webserver_enabled_def"
            app:icon="@drawable/ic_dns_24dp"
            app:key="@string/pref_webserver_enabled_key"
            app:singleLineTitle="false"
            app:title="@string/pref_webserver_enabled" />
        <Preference
            app:dependency="@string/pref_webserver_enabled_key"
            app:icon="@drawable/ic_open_in_browser_24dp"
            app:key="@string/pref_webserver_test_key"
            app:persistent="false"
            app:singleLineTitle="false"
            app:summary="@string/pref_webserver_state_checking"
            app:title="@string/pref_webserver_test" />
        <Preference
            app:dependency="@string/pref_webserver_enabled_key"
            app:icon="@drawable/ic_verified_user_24dp"
            app:key="@string/pref_webserver_certificate_key"
            app:persistent="false"
            app:singleLineTitle="false"
            app:title="@string/pref_webserver_certificate" />
        <SwitchPreferenceCompat
            app:defaultValue="@bool/pref_webserver_icon_def"
            app:dependency="@string/pref_webserver_enabled_key"
            app:icon="@drawable/ic_image_24dp"
            app:key="@string/pref_webserver_icon_key"
            app:singleLineTitle="false"
            app:title="@string/pref_webserver_icon" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_ad_block_category">
        <SwitchPreferenceCompat
            app:defaultValue="@bool/pref_enable_ipv6_def"
            app:icon="@drawable/ic_ipv6_24dp"
            app:key="@string/pref_enable_ipv6_key"
            app:singleLineTitle="false"
            app:title="@string/pref_enable_ipv6" />
        <Preference
            app:fragment="org.adaway.ui.prefs.PrefsBackupRestoreFragment"
            app:icon="@drawable/ic_sd_storage_24dp"
            app:singleLineTitle="false"
            app:title="@string/pref_backup_restore" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="@string/pref_debug_category_key"
        app:title="@string/pref_debug_category">
        <SwitchPreferenceCompat
            app:defaultValue="@bool/pref_enable_debug_def"
            app:icon="@drawable/ic_bug_report_24dp"
            app:key="@string/pref_enable_debug_key"
            app:singleLineTitle="false"
            app:summary="@string/pref_enable_debug_summary"
            app:title="@string/pref_enable_debug" />
    </PreferenceCategory>

</PreferenceScreen>
