    <string name="welcome_method_header">ברוכים הבאים אל AdAway!</string>
    <string name="welcome_method_summary">‏AdAway מספק שני שיטות חסימת פרסומות. בחר\י את השיטה שמתאימה לך:</string>
    <string name="welcome_root_method_title">מבוסס גישת שורש\nחוסם פרסומות</string>
    <string name="welcome_root_method_text1">מהיר יותר</string>
    <string name="welcome_root_method_text2">ידידותי לסוללה</string>
    <string name="welcome_root_method_text3">נדרש גישת שורש</string>
    <string name="welcome_vpn_method_title">מבוסס VPN\nחוסם פרסומות</string>
    <string name="welcome_vpn_method_text1">איטי יותר</string>
    <string name="welcome_vpn_method_text2">פועל ברקע</string>
    <string name="welcome_vpn_method_text3">תאימות</string>
    <string name="welcome_root_missing_title">נדרשת הרשאת ROOT</string>
    <string name="welcome_root_missile_description">לא אפשרת הרשאת Root ל־AdAway.\n\nזה יכול לקרות כאשר המכשיר שלך אינו בעל הרשאת Root. תוכל\י למצוא מידע על אופן ביצוע Root במכשיר שלך ב־wiki.lineageos.org או באתרים דומים.</string>
    <string name="welcome_vpn_alwayson_title">הפעלת \"VPN תמיד פעיל\"</string>
    <string name="welcome_vpn_alwayson_description">AdAway זיהתה ש-VPN אחר משתמש בהגדרה \"‏VPN תמיד פעיל\".\n\nהדבר מונע מ-AdAway לבקש גישת VPN. אנא השבת את ההגדרה \"‏VPN תמיד פעיל\" ב-VPN המתאים ונסה שוב.</string>
    <string name="welcome_vpn_alwayson_blocked_description">‏AdAway נכשלה בבקשת גישת VPN.\n\nייתכן שהסיבה לכך היא ש-VPN אחר משתמש בהגדרה \"‏VPN תמיד פעיל\". אנא בדוק אם יש VPN כלשהו שבו ההגדרה הזו מופעלת והשבת אותה לפני שתנסה שוב.</string>
    <string name="welcome_vpn_alwayson_settings_action">פתח\י הגדרות \"VPN\"</string>
    <string name="welcome_method_pro_logo">מקצועי</string>
    <string name="welcome_method_con_logo">עם</string>
    <string name="welcome_sync_header">מסנכרן</string>
    <string name="welcome_synced_header">מסונכרן!</string>
    <string name="welcome_sync_summary">AdAway מוריד רשתות של מודעות כדי לחסום אותן ממקורותיהן המקוונים. אתה יכול להתאים אותן מאוחר יותר בהגדרות.</string>
    <string name="welcome_sync_retry_logo">נסה סנכרון מחדש</string>
    <string name="welcome_sync_error">סנכרון נכשל: %1$s לנסות כעת?</string>
    <string name="welcome_sync_notifications">היישום יכול לשלוח התראות להצגת מצב ושליטה בחסימת פרסומות, וכן להודיע על עדכוני אפליקציה זמינים (כמה פעמים בשנה). הפעל התראות אלו אם ברצונך להישאר מעודכן.</string>
    <string name="welcome_sync_leave_early_title">הסנכרון עדיין לא הסתיים</string>
    <string name="welcome_sync_leave_early_message">הורדת רשימות החסימה עדיין לא הסתיימה. תוכל להמשיך עכשיו והיא תמשיך ברקע, או להמתין כאן עד לסיומה.</string>
    <string name="welcome_sync_leave_early_wait">המתן</string>
    <string name="welcome_sync_leave_early_continue">המשך בכל זאת</string>
    <string name="welcome_back_button">חזור</string>
    <string name="welcome_next_button">הבא</string>
    <string name="welcome_finish_button">סיום</string>
    <string name="tv_welcome_intro_subtitle">אשף קצר זה יפעיל את חסימת הפרסומות במכשיר הזה.</string>
    <string name="tv_welcome_start_button">התחלה</string>
    <string name="tv_welcome_method_header">בחר את שיטת החסימה שלך</string>
    <string name="tv_welcome_method_root_button">השתמש ב-root</string>
    <string name="tv_welcome_method_root_body">מהיר יותר וחסכוני יותר בסוללה. דורש מכשיר עם הרשאות root.</string>
    <string name="tv_welcome_method_vpn_button">השתמש ב-VPN</string>
    <string name="tv_welcome_method_vpn_body">פועל ללא root, תואם לכל מכשיר Android TV.</string>
    <string name="tv_welcome_activate_header">הפעלת חסימת פרסומות</string>
    <string name="tv_welcome_activate_body">זהו VPN מקומי: הוא מסנן פרסומות במכשיר עצמו, מבלי לנתב את התעבורה שלך דרך שרת חיצוני.</string>
