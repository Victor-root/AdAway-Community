    <string name="pref_vpn_diagnostic_log_enabled">Rakam log diagnostik</string>
    <string name="pref_vpn_diagnostic_log_enabled_description">Hidupkan sebelum menghasilkan semula masalah, kemudian eksport log di bawah. Mungkin sedikit memperlahankan peranti lama. Hanya peristiwa teknikal VPN dirakam, tidak pernah sejarah pelayaran atau data peribadi.</string>
