<resources>
    <!-- Service configuration -->
    <string name="pref_vpn_service_on_boot">Activer au démarrage</string>
    <string name="pref_vpn_service_monitor">Surveiller la connexion</string>
    <string name="pref_vpn_service_monitor_description">Vérifier régulièrement l’état du réseau pour relancer le RPV/VPN après une déconnexion.</string>
    <!-- Excluded applications -->
    <string name="pref_vpn_excluded_apps_description">Configurer les applis qui ne devraient pas utiliser le RPV/VPN, afin qu’aucune connexion ne soit bloquée.</string>
    <string name="pref_vpn_exclude_system_apps">Exclure les applications système</string>
    <string-array name="pref_vpn_excluded_system_apps_entries">
        <item>Aucune</item>
        <item>Toutes, sauf les navigateurs</item>
        <item>Toutes</item>
    </string-array>
    <string name="pref_vpn_exclude_user_apps">Exclure des applications utilisateur</string>

    <!-- Exclude user apps activity -->
    <string name="pref_vpn_exclude_user_apps_activity">Applications exclues</string>
    <string name="pref_vpn_exclude_user_apps_select_all">Les sélectionner toutes</string>
    <string name="pref_vpn_exclude_user_apps_deselect_all">Les dessélectionner toutes</string>
    <string name="pref_vpn_exclude_user_apps_icon">Icône de l’application</string>

    <!-- Troubleshooting -->
    <string name="pref_vpn_reset">Réinitialiser le RPV/VPN</string>
    <string name="pref_vpn_reset_description">Reconstruire entièrement la connexion RPV/VPN. À utiliser si le RPV/VPN ne fonctionne plus (pas d’accès à Internet ou erreurs DNS).</string>
    <string name="pref_vpn_reset_done">Connexion RPV/VPN reconstruite.</string>
    <string name="pref_vpn_reset_not_running">Le RPV/VPN n’est pas actif.</string>
    <string name="pref_vpn_diagnostic_log_enabled">Enregistrer le journal de diagnostic</string>
    <string name="pref_vpn_diagnostic_log_enabled_description">Activez-la avant de reproduire un problème, puis exportez-la ci-dessous. Peut légèrement ralentir les appareils anciens. N’enregistre que des événements techniques du RPV/VPN, jamais de données personnelles.</string>
    <string name="pref_vpn_diagnostic_log">Journal de diagnostic</string>
    <string name="pref_vpn_diagnostic_log_description">Consulter, copier ou partager les erreurs et événements RPV/VPN récents. Utile pour signaler un problème.</string>
    <string name="pref_vpn_diagnostic_log_empty">Aucun événement n’a encore été enregistré. Activez « Enregistrer le journal de diagnostic » ci-dessus, puis essayez de reproduire le problème.</string>
    <string name="pref_vpn_diagnostic_log_share">Partager</string>
    <string name="pref_vpn_diagnostic_log_share_title">Partager le journal de diagnostic</string>
    <string name="pref_vpn_diagnostic_log_copy">Copier</string>
    <string name="pref_vpn_diagnostic_log_copied">Journal de diagnostic copié dans le presse-papiers.</string>
    <string name="pref_vpn_diagnostic_log_clear">Effacer le journal de diagnostic</string>
    <string name="pref_vpn_diagnostic_log_clear_description">Supprimer les événements enregistrés. À faire avant de reproduire un problème pour capturer une trace propre.</string>
    <string name="pref_vpn_diagnostic_log_cleared">Journal de diagnostic effacé.</string>
</resources>
