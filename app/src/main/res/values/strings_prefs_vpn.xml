<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Service configuration -->
    <string name="pref_vpn_service_on_boot">Enable at startup</string>
    <string name="pref_vpn_service_monitor">Monitor connection</string>
    <string name="pref_vpn_service_monitor_description">Periodically check the network state to restart VPN on disconnection.</string>
    <!-- Excluded applications -->
    <string name="pref_vpn_excluded_apps_description">Configure which applications should not use the VPN so no connections will be blocked.</string>
    <string name="pref_vpn_exclude_system_apps">Exclude system applications</string>
    <string-array name="pref_vpn_excluded_system_apps_entries">
        <item>None</item>
        <item>All except browsers</item>
        <item>All</item>
    </string-array>
    <string name="pref_vpn_exclude_user_apps">Exclude user applications</string>

    <!-- Exclude user apps activity -->
    <string name="pref_vpn_exclude_user_apps_activity">Excluded applications</string>
    <string name="pref_vpn_exclude_user_apps_select_all">Select all</string>
    <string name="pref_vpn_exclude_user_apps_deselect_all">Deselect all</string>
    <string name="pref_vpn_exclude_user_apps_icon">Application icon</string>

    <!-- Troubleshooting -->
    <string name="pref_vpn_reset">Reset VPN</string>
    <string name="pref_vpn_reset_description">Rebuild the VPN connection from scratch. Use this if the VPN stops working (no internet access or DNS errors).</string>
    <string name="pref_vpn_reset_done">VPN connection rebuilt.</string>
    <string name="pref_vpn_reset_not_running">VPN is not running.</string>
    <string name="pref_vpn_diagnostic_log_enabled">Record diagnostic log</string>
    <string name="pref_vpn_diagnostic_log_enabled_description">Turn on before reproducing a problem, then export it below. May slightly slow down older devices. Records only technical VPN events, never browsing history or personal data.</string>
    <string name="pref_vpn_diagnostic_log">Diagnostic log</string>
    <string name="pref_vpn_diagnostic_log_description">View, copy or share the recent errors and VPN events. Useful when reporting a problem.</string>
    <string name="pref_vpn_diagnostic_log_empty">No events have been recorded yet. Turn on \"Record diagnostic log\" above, then try to reproduce the problem.</string>
    <string name="pref_vpn_diagnostic_log_share">Share</string>
    <string name="pref_vpn_diagnostic_log_share_title">Share diagnostic log</string>
    <string name="pref_vpn_diagnostic_log_copy">Copy</string>
    <string name="pref_vpn_diagnostic_log_copied">Diagnostic log copied to clipboard.</string>
    <string name="pref_vpn_diagnostic_log_clear">Clear diagnostic log</string>
    <string name="pref_vpn_diagnostic_log_clear_description">Delete the recorded events. Do this before reproducing a problem to capture a clean trace.</string>
    <string name="pref_vpn_diagnostic_log_cleared">Diagnostic log cleared.</string>
</resources>
