    <string name="welcome_tv_use_vpn">Use VPN</string>
    <string name="welcome_tv_use_vpn_summary">Works without root, on any Android TV device.</string>

    <string name="root_required_title">Rooted Android required</string>
    <string name="root_required_text">Either the su binary could not be found or you did not allow root access for AdAway.\n\nThis happens when your device is not rooted. You can find how to root your device on wiki.lineageos.org or other Android websites.</string>
    <string name="always_on_vpn_title">Always-on VPN enabled</string>
    <string name="always_on_vpn_text">Another VPN app has the \"Always-on VPN\" setting enabled, which prevents AdAway from starting its VPN.\n\nTurn off \"Always-on VPN\" for that app, then try again.</string>
    <string name="vpn_request_failed_title">VPN access not granted</string>
    <string name="vpn_request_failed_text">AdAway could not get VPN access.\n\nAnother VPN app may have the \"Always-on VPN\" setting enabled. Check your VPN settings, turn it off, then try again.</string>
