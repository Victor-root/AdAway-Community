    <string name="pref_vpn_diagnostic_log_clear">Tomara teşhîsê paqij bike</string>
    <string name="pref_vpn_diagnostic_log_clear_description">Bûyerên tomarkirî jê bibe. Berî ku pirsgirêkê dubare bikî vê bike da ku şopeke paqij bistînî.</string>
    <string name="pref_vpn_diagnostic_log_cleared">Tomara teşhîsê hate paqijkirin.</string>
