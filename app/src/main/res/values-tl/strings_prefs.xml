    <string name="pref_webserver_certificate_dialog_title">Manual na pag-install ng certificate</string>
    <string name="pref_webserver_certificate_dialog_content">Simula sa Android 11 (R), hindi na awtomatikong makakapag-install ng certificate authority (CA) ang mga app.\n\nPumunta sa mga setting ng “Seguridad”, “Pag-encrypt at mga kredensyal”, pagkatapos ay “Mag-install ng certificate”. Mula roon, piliin ang “CA certificate”, pagkatapos ay ang bagong na-export na certificate file.</string>
