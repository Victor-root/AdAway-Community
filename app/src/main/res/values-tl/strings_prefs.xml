    <string name="pref_vpn_diagnostic_log_copy">Kopyahin</string>
    <string name="pref_vpn_diagnostic_log_copied">Nakopya ang log ng diagnostic sa clipboard.</string>
    <string name="pref_vpn_diagnostic_log_clear">I-clear ang log ng diagnostic</string>
    <string name="pref_vpn_diagnostic_log_clear_description">Burahin ang mga na-record na event. Gawin ito bago ulitin ang problema para makakuha ng malinis na trace.</string>
    <string name="pref_vpn_diagnostic_log_cleared">Na-clear ang log ng diagnostic.</string>
