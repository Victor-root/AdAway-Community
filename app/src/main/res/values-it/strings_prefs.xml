    <string name="pref_vpn_diagnostic_log_description">Visualizza, copia o condividi gli errori e gli eventi VPN recenti. Utile quando segnali un problema.</string>
    <string name="pref_vpn_diagnostic_log_empty">Nessun evento registrato finora. Attiva «Registrazione diagnostica» qui sopra, poi prova a riprodurre il problema.</string>
