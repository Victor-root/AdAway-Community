<resources>
    <string name="welcome_first_step">向导第一步</string>
    <string name="welcome_second_step">向导第二步</string>
    <string name="welcome_third_step">向导第三步</string>
    <string name="welcome_fourth_step">向导第四步</string>
    <string name="welcome_method_header">欢迎使用 AdAway！</string>
    <string name="welcome_method_summary">AdAway 提供两种广告拦截方式，请选择您喜欢的一种：</string>
    <string name="welcome_root_method_title">基于 root 的\n广告拦截</string>
    <string name="welcome_root_method_text1">速度更快</string>
    <string name="welcome_root_method_text2">更省电</string>
    <string name="welcome_root_method_text3">需要 root 权限</string>
    <string name="welcome_vpn_method_title">基于 VPN 的\n广告拦截</string>
    <string name="welcome_vpn_method_text1">速度较慢</string>
    <string name="welcome_vpn_method_text2">在后台运行</string>
    <string name="welcome_vpn_method_text3">兼容性好</string>
    <string name="welcome_root_missing_title">需要已 root 的 Android 设备</string>
    <string name="welcome_root_missile_description">要么找不到 su 程序，要么您没有授予 AdAway root 权限。\n\n设备未 root 时可能出现这种情况。您可以在 wiki.lineageos.org 或其他 Android 网站上了解如何 root 您的设备。</string>
    <string name="welcome_vpn_alwayson_title">已启用“始终开启的 VPN”</string>
    <string name="welcome_vpn_alwayson_description">AdAway 检测到另一个 VPN 启用了“始终开启的 VPN”设置。\n\n这会导致 AdAway 无法申请 VPN 访问权限。请在对应的 VPN 中关闭“始终开启的 VPN”，然后重试。</string>
    <string name="welcome_vpn_alwayson_blocked_description">AdAway 申请 VPN 访问权限失败。\n\n可能是因为另一个 VPN 启用了“始终开启的 VPN”设置。请检查是否有 VPN 启用了该设置，并先将其关闭再重试。</string>
    <string name="welcome_vpn_alwayson_settings_action">打开“VPN”设置</string>
    <string name="welcome_method_pro_logo">优点</string>
    <string name="welcome_method_con_logo">缺点</string>
    <string name="welcome_sync_header">正在同步</string>
    <string name="welcome_synced_header">同步完成！</string>
    <string name="welcome_sync_summary">AdAway 会从在线来源下载需要拦截的广告网络列表。您之后可以在设置中自定义。</string>
    <string name="welcome_sync_retry_logo">重试同步</string>
    <string name="welcome_sync_error">同步失败：%1$s。要现在重试吗？</string>
    <string name="welcome_sync_notifications">AdAway 可以发送通知，显示广告拦截状态并提供控制，也会在有应用更新时提醒您（每年仅几次）。如果想及时获取更新，请开启通知。</string>
    <string name="welcome_sync_leave_early_title">同步尚未完成</string>
    <string name="welcome_sync_leave_early_message">拦截列表尚未下载完成。您可以现在继续，下载会在后台进行；也可以在此等待，直到完成。</string>
    <string name="welcome_sync_leave_early_wait">等待</string>
    <string name="welcome_sync_leave_early_continue">仍然继续</string>
    <string name="welcome_battery_header">在后台保持防护</string>
    <string name="welcome_battery_summary">Android 可能会为省电而在后台暂停 AdAway 的 VPN，这会在不知不觉中停止广告拦截。请允许 AdAway 忽略电池优化，使其持续运行。</string>
    <string name="welcome_battery_action">允许</string>
    <string name="welcome_battery_granted">已允许 ✓</string>
    <string name="welcome_battery_footnote_prefix">您之后随时可以在此更改：</string>
    <string-array name="welcome_battery_footnote_path">
        <item>设置</item>
        <item>应用</item>
        <item>AdAway</item>
        <item>电池</item>
    </string-array>
    <string name="welcome_oem_battery_header">还有一件事：手机自带的电池管理</string>
    <string name="welcome_oem_battery_summary">部分手机品牌有自己的电池管理功能，也可能限制 AdAway。请在您的手机上检查以下内容：</string>
    <string name="welcome_oem_battery_action">打开应用信息</string>
    <string name="welcome_oem_battery_open_failed">无法打开应用信息页面。请手动前往“设置 → 应用 → AdAway”打开。</string>
    <string name="welcome_oem_battery_disclaimer">以下仅为通用提示，并非精确指南：具体名称和位置可能因手机型号和 Android 版本而异。</string>
    <string name="welcome_oem_battery_label_oneui">Samsung (One UI)</string>
    <string-array name="welcome_oem_battery_path_oneui">
        <item>应用信息</item>
        <item>电池</item>
    </string-array>
    <string name="welcome_oem_battery_instruction_oneui">找到类似“后台使用限制”›“永不休眠的应用”的选项，然后将 AdAway 加入该列表。</string>
    <string name="welcome_oem_battery_secondary_oneui">另请查看是否有“自动优化”设置，如有，请关闭其中的“需要时重启”。</string>
    <string name="welcome_oem_battery_label_miui">Xiaomi / Redmi / POCO (MIUI / HyperOS)</string>
    <string-array name="welcome_oem_battery_path_miui">
        <item>应用信息</item>
        <item>省电策略</item>
    </string-array>
    <string name="welcome_oem_battery_instruction_miui">选择“无限制”。</string>
    <string name="welcome_oem_battery_secondary_miui">同时开启“自启动”（新版本中为“后台自启动”）。</string>
    <string name="welcome_oem_battery_label_coloros">Oppo / OnePlus / Realme (ColorOS)</string>
    <string-array name="welcome_oem_battery_path_coloros">
        <item>应用信息</item>
        <item>耗电管理</item>
    </string-array>
    <string name="welcome_oem_battery_instruction_coloros">选择“允许后台行为”（有时显示为“无限制”）。</string>
    <string name="welcome_oem_battery_secondary_coloros">另请为 AdAway 查找“自启动”开关（通常位于“设置 › 应用”下），这样它在被强行停止后能自行重新启动。</string>
    <string name="welcome_oem_battery_label_emui">Huawei / Honor (EMUI / MagicOS)</string>
    <string-array name="welcome_oem_battery_path_emui">
        <item>应用信息</item>
        <item>电池</item>
    </string-array>
    <string name="welcome_oem_battery_instruction_emui">找到“应用启动管理”，关闭“自动管理”，然后将“自启动”“关联启动”和“后台活动”3 项全部开启。</string>
    <string name="welcome_oem_battery_secondary_emui">同时在最近任务界面中锁定 AdAway（在其卡片上向下滑动，直到出现锁形图标）。</string>
    <string name="welcome_oem_battery_label_funtouch">vivo / iQOO (Funtouch / OriginOS)</string>
    <string-array name="welcome_oem_battery_path_funtouch">
        <item>应用信息</item>
        <item>耗电管理</item>
    </string-array>
    <string name="welcome_oem_battery_instruction_funtouch">找到后台耗电相关选项，选择“允许后台高耗电”（不要选“智能限制”）。</string>
    <string name="welcome_oem_battery_secondary_funtouch">另请为 AdAway 查找“自启动”设置，通常位于“设置 › 应用与权限”下。</string>
    <string name="welcome_oem_battery_label_generic">其他品牌</string>
    <string name="welcome_oem_battery_tip_generic">请在应用信息中查找电池或后台活动相关设置，确保 AdAway 没有受到限制。</string>
    <string name="welcome_back_button">返回</string>
    <string name="welcome_next_button">下一步</string>
    <string name="welcome_finish_button">完成</string>
    <string name="tv_welcome_intro_subtitle">这个简短的向导将在此设备上开启广告拦截。</string>
    <string name="tv_welcome_start_button">开始使用</string>
    <string name="tv_welcome_method_header">选择拦截方式</string>
    <string name="tv_welcome_method_root_button">使用 root</string>
    <string name="tv_welcome_method_root_body">速度更快、更省电。需要已 root 的设备。</string>
    <string name="tv_welcome_method_vpn_button">使用 VPN</string>
    <string name="tv_welcome_method_vpn_body">无需 root，兼容所有 Android TV 设备。</string>
    <string name="tv_welcome_activate_header">开启广告拦截</string>
    <string name="tv_welcome_activate_body">这是一个本地 VPN：它在此设备上过滤广告，不会把您的流量转发到外部服务器。</string>
</resources>
