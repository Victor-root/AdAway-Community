    <string name="welcome_root_missing_title">مطلوب روت للهاتف</string>
    <string name="welcome_root_missile_description">إما أن su binary لا يمكن العثور عليه أو أنك لم تسمح بإذن الجذر لـ AdAway. يمكن أن يحدث هذا عندما لا يكون جهازك بدون رووت. يمكنك العثور على معلومات حول كيفية عمل رووت لجهازك على wiki.lineageos.org أو مواقع Android الأخرى.</string>
    <string name="welcome_method_pro_logo">إحترافي</string>
    <string name="welcome_method_con_logo">عيوب</string>
    <string name="welcome_sync_header">جاري المزامنة</string>
    <string name="welcome_synced_header">تمت المزامنة</string>
    <string name="welcome_sync_summary">AdAway يقوم بتنزيل شبكات الإعلانات لمنعها من المصادر عبر الإنترنت. يمكنك تخصيصها لاحقًا في الإعدادات.</string>
    <string name="welcome_sync_retry_logo">أعد محاولة المزامنة</string>
    <string name="welcome_sync_error">فشل مزامنة: %1$s إعادة المحاولة الآن</string>
    <string name="welcome_sync_notifications">يمكنه إرسال إشعارات لعرض حالة حظر الإعلانات والتحكم فيها، وإعلامك بتحديث التطبيق المتاح (عدد قليل في السنة). قم بتمكينها إذا كنت ترغب في البقاء على اطلاع دائم.</string>
    <string name="welcome_sync_leave_early_title">المزامنة لم تنته بعد</string>
    <string name="welcome_sync_leave_early_message">لم يكتمل تنزيل قوائم الحظر بعد. يمكنك المتابعة الآن وستستمر في الخلفية، أو الانتظار هنا حتى الانتهاء.</string>
    <string name="welcome_sync_leave_early_wait">انتظار</string>
    <string name="welcome_sync_leave_early_continue">المتابعة على أي حال</string>
    <string name="welcome_back_button">رجوع</string>
    <string name="welcome_next_button">التالي</string>
    <string name="welcome_finish_button">إنتهاء</string>
    <string name="tv_welcome_intro_subtitle">سيؤدي هذا المعالج القصير إلى تفعيل حظر الإعلانات على هذا الجهاز.</string>
    <string name="tv_welcome_start_button">ابدأ</string>
    <string name="tv_welcome_method_header">اختر طريقة الحظر الخاصة بك</string>
    <string name="tv_welcome_method_root_button">استخدام الروت</string>
    <string name="tv_welcome_method_root_body">أسرع وأكثر توفيرًا للبطارية. يتطلب جهازًا مروتًا (root).</string>
    <string name="tv_welcome_method_vpn_button">استخدام VPN</string>
    <string name="tv_welcome_method_vpn_body">يعمل بدون روت، متوافق مع أي جهاز Android TV.</string>
    <string name="tv_welcome_activate_header">تفعيل حظر الإعلانات</string>
    <string name="tv_welcome_activate_body">إنها شبكة VPN محلية: تقوم بتصفية الإعلانات على هذا الجهاز دون توجيه بياناتك عبر خادم خارجي.</string>
