    <string name="pref_vpn_diagnostic_log_enabled">Zaznamenávať diagnostický protokol</string>
    <string name="pref_vpn_diagnostic_log_enabled_description">Zapnite túto možnosť, skôr ako problém znova vyvoláte, a potom protokol exportujte nižšie. Staršie zariadenia môže mierne spomaliť. Zaznamenáva iba technické udalosti VPN, nikdy nie históriu prehliadania ani osobné údaje.</string>
