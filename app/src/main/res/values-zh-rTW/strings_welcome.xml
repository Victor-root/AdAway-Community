<resources>
    <string name="welcome_first_step">精靈第一步</string>
    <string name="welcome_second_step">精靈第二步</string>
    <string name="welcome_third_step">精靈第三步</string>
    <string name="welcome_fourth_step">精靈第四步</string>
    <string name="welcome_method_header">歡迎使用 AdAway！</string>
    <string name="welcome_method_summary">AdAway 提供兩種廣告封鎖方式，請選擇你喜歡的一種：</string>
    <string name="welcome_root_method_title">root 模式\n廣告封鎖</string>
    <string name="welcome_root_method_text1">速度較快</string>
    <string name="welcome_root_method_text2">較省電</string>
    <string name="welcome_root_method_text3">需要 root</string>
    <string name="welcome_vpn_method_title">VPN 模式\n廣告封鎖</string>
    <string name="welcome_vpn_method_text1">速度較慢</string>
    <string name="welcome_vpn_method_text2">在背景執行</string>
    <string name="welcome_vpn_method_text3">相容性佳</string>
    <string name="welcome_root_missing_title">需要已 root 的 Android</string>
    <string name="welcome_root_missile_description">找不到 su 執行檔，或是你沒有授予 AdAway root 權限。\n\n如果你的裝置尚未 root，就可能發生這種情況。你可以在 wiki.lineageos.org 或其他 Android 網站找到如何 root 裝置的資訊。</string>
    <string name="welcome_vpn_alwayson_title">「永遠開啟的 VPN」已啟用</string>
    <string name="welcome_vpn_alwayson_description">AdAway 偵測到另一個 VPN 已啟用「永遠開啟的 VPN」設定。\n\n這會使 AdAway 無法要求 VPN 存取權。請在該 VPN 中停用「永遠開啟的 VPN」，然後再試一次。</string>
    <string name="welcome_vpn_alwayson_blocked_description">AdAway 無法要求 VPN 存取權。\n\n可能是因為另一個 VPN 已啟用「永遠開啟的 VPN」設定。請檢查是否有 VPN 啟用了這項設定，並先停用，再重新嘗試。</string>
    <string name="welcome_vpn_alwayson_settings_action">開啟「VPN」設定</string>
    <string name="welcome_method_pro_logo">優點</string>
    <string name="welcome_method_con_logo">缺點</string>
    <string name="welcome_sync_header">同步中</string>
    <string name="welcome_synced_header">同步完成！</string>
    <string name="welcome_sync_summary">AdAway 會從線上來源下載要封鎖的廣告網路清單，你之後可以在設定中自訂。</string>
    <string name="welcome_sync_retry_logo">重試同步</string>
    <string name="welcome_sync_error">同步失敗：%1$s。要現在重試嗎？</string>
    <string name="welcome_sync_notifications">AdAway 可以傳送通知，顯示廣告封鎖的狀態與控制項，並告知有可用的應用程式更新（每年幾次）。如果想隨時掌握最新版本，請開啟通知。</string>
    <string name="welcome_sync_leave_early_title">同步尚未完成</string>
    <string name="welcome_sync_leave_early_message">封鎖清單尚未下載完畢。你可以現在繼續，下載會在背景持續進行，也可以在這裡等候完成。</string>
    <string name="welcome_sync_leave_early_wait">等待</string>
    <string name="welcome_sync_leave_early_continue">仍要繼續</string>
    <string name="welcome_battery_header">在背景持續保護你</string>
    <string name="welcome_battery_summary">Android 可能會為了省電而暫停 AdAway 在背景執行的 VPN，導致廣告封鎖在你不知情的情況下停止。請允許 AdAway 忽略電池最佳化，讓它持續執行。</string>
    <string name="welcome_battery_action">允許</string>
    <string name="welcome_battery_granted">已允許 ✓</string>
    <string name="welcome_battery_footnote_prefix">你日後隨時可以在以下位置變更這項設定：</string>
    <string-array name="welcome_battery_footnote_path">
        <item>設定</item>
        <item>應用程式</item>
        <item>AdAway</item>
        <item>電池</item>
    </string-array>
    <string name="welcome_oem_battery_header">還有一件事：手機內建的電池管理</string>
    <string name="welcome_oem_battery_summary">部分手機品牌有自己的電池管理功能，同樣可能阻擋 AdAway。請在你的手機上檢查下列項目：</string>
    <string name="welcome_oem_battery_action">開啟應用程式資訊</string>
    <string name="welcome_oem_battery_open_failed">無法開啟應用程式資訊畫面。請手動前往「設定」 › 「應用程式」 › 「AdAway」開啟。</string>
    <string name="welcome_oem_battery_disclaimer">以下僅為一般性提示，並非精確的操作指引：實際名稱與位置可能因手機型號與 Android 版本而異。</string>
    <string name="welcome_oem_battery_label_oneui">Samsung (One UI)</string>
    <string-array name="welcome_oem_battery_path_oneui">
        <item>應用程式資訊</item>
        <item>電池</item>
    </string-array>
    <string name="welcome_oem_battery_instruction_oneui">請尋找類似「背景使用限制」 › 「永不休眠的應用程式」的選項，然後將 AdAway 加入該清單。</string>
    <string name="welcome_oem_battery_secondary_oneui">另外請檢查是否有「自動最佳化」設定，若有「必要時重新啟動」，請將它關閉。</string>
    <string name="welcome_oem_battery_label_miui">Xiaomi / Redmi / POCO (MIUI / HyperOS)</string>
    <string-array name="welcome_oem_battery_path_miui">
        <item>應用程式資訊</item>
        <item>省電策略</item>
    </string-array>
    <string name="welcome_oem_battery_instruction_miui">請選擇「無限制」。</string>
    <string name="welcome_oem_battery_secondary_miui">另外請啟用「自動啟動」（較新版本為「背景自動啟動」）。</string>
    <string name="welcome_oem_battery_label_coloros">Oppo / OnePlus / Realme (ColorOS)</string>
    <string-array name="welcome_oem_battery_path_coloros">
        <item>應用程式資訊</item>
        <item>耗電管理</item>
    </string-array>
    <string name="welcome_oem_battery_instruction_coloros">請選擇「允許背景活動」（有時顯示為「無限制」）。</string>
    <string name="welcome_oem_battery_secondary_coloros">另外請找找看 AdAway 是否有「自動啟動」開關（通常位於設定 › 應用程式），這樣它在被強制停止後才能自行重新啟動。</string>
    <string name="welcome_oem_battery_label_emui">Huawei / Honor (EMUI / MagicOS)</string>
    <string-array name="welcome_oem_battery_path_emui">
        <item>應用程式資訊</item>
        <item>電池</item>
    </string-array>
    <string name="welcome_oem_battery_instruction_emui">請尋找「應用程式啟動管理」，關閉「自動管理」，然後將 3 個選項全部啟用：「自動啟動」、「關聯啟動」和「背景活動」。</string>
    <string name="welcome_oem_battery_secondary_emui">另外請在最近使用畫面中鎖定 AdAway（將它的卡片向下滑動，直到出現鎖頭圖示）。</string>
    <string name="welcome_oem_battery_label_funtouch">vivo / iQOO (Funtouch / OriginOS)</string>
    <string-array name="welcome_oem_battery_path_funtouch">
        <item>應用程式資訊</item>
        <item>耗電管理</item>
    </string-array>
    <string name="welcome_oem_battery_instruction_funtouch">請尋找背景耗電選項，並選擇「不限制背景耗電」（不要選「智慧控制」）。</string>
    <string name="welcome_oem_battery_secondary_funtouch">另外請找找看 AdAway 是否有「自啟動」設定，通常位於設定 › 應用程式。</string>
    <string name="welcome_oem_battery_label_generic">其他品牌</string>
    <string name="welcome_oem_battery_tip_generic">請在應用程式資訊中尋找電池或背景活動設定，並確認 AdAway 沒有受到限制。</string>
    <string name="welcome_back_button">返回</string>
    <string name="welcome_next_button">下一步</string>
    <string name="welcome_finish_button">完成</string>
    <string name="tv_welcome_intro_subtitle">這個簡短的精靈會在這部裝置上開啟廣告封鎖。</string>
    <string name="tv_welcome_start_button">開始使用</string>
    <string name="tv_welcome_method_header">選擇封鎖方式</string>
    <string name="tv_welcome_method_root_button">使用 root</string>
    <string name="tv_welcome_method_root_body">速度較快且省電，需要已 root 的裝置。</string>
    <string name="tv_welcome_method_vpn_button">使用 VPN</string>
    <string name="tv_welcome_method_vpn_body">不需要 root，相容於任何 Android TV 裝置。</string>
    <string name="tv_welcome_activate_header">開啟廣告封鎖</string>
    <string name="tv_welcome_activate_body">這是本機 VPN：它會在這部裝置上過濾廣告，不會將你的流量轉送到外部伺服器。</string>
</resources>
