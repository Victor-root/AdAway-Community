    <string name="vpn_persistence_summary">Giữ cho tính năng chặn quảng cáo luôn chạy ở chế độ nền</string>
    <string name="vpn_persistence_enabled">VPN luôn bật đã được bật cho AdAway. ✓</string>
    <string name="vpn_persistence_disabled">Chưa đặt VPN luôn bật. Cơ chế duy trì tích hợp sẵn của AdAway sẽ đảm nhiệm việc này.</string>
    <string name="vpn_persistence_lockdown">Tùy chọn “Chặn các kết nối không dùng VPN” đang bật: các ứng dụng bị loại trừ khỏi VPN sẽ không có quyền truy cập Internet.</string>
    <string name="vpn_persistence_message">AdAway đã tự xử lý được các trường hợp khởi động lại máy, bị hệ thống tắt do thiếu bộ nhớ và sự cố, nên trong hầu hết trường hợp bạn không cần thiết lập thêm.\n\nNếu VPN vẫn dừng đột ngột, hãy ghim AdAway làm VPN luôn bật của hệ thống Android để được đảm bảo chắc chắn nhất.</string>
    <string name="vpn_persistence_adb_commands">Nếu màn hình VPN của hệ thống bị ẩn trên TV của bạn, hãy dùng ADB, rồi khởi động lại TV:\n\n• Bật chế độ luôn bật cho AdAway:\n  adb shell settings put secure always_on_vpn_app %1$s\n\n• Tắt chế độ luôn bật:\n  adb shell settings delete secure always_on_vpn_app</string>
    <string name="vpn_persistence_tv_settings_unavailable">Cài đặt VPN bị ẩn trên Android TV này. Hãy dùng các lệnh ADB được hiển thị.</string>
